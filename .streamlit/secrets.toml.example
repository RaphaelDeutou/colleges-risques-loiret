# Copiez ce fichier en .streamlit/secrets.toml (ignoré par git) et remplissez-le.
# Ne collez JAMAIS votre clé dans ce fichier-ci : il est versionné, donc public sur GitHub.
# Sur Streamlit Cloud : Manage app → Settings → Secrets, collez les mêmes lignes.

# LLM compatible OpenAI : Groq (clé gratuite sur https://console.groq.com/keys)
LLM_URL = "https://api.groq.com/openai/v1"
LLM_KEY = "collez-votre-cle-groq-ici"
# Un modèle Groq qui sait appeler des outils (liste à jour sur console.groq.com/docs/models)
LLM_MODEL = "openai/gpt-oss-120b"

# Adresse de l'API FastAPI : en local, uvicorn ; une fois déployée, l'URL Render
API_URL = "http://127.0.0.1:8000"
